<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Hyplix Launcher | Coming Soon</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      overflow: hidden;
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at 50% 45%, #18245a 0%, #080b20 35%, #02030c 75%);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    /* Stars */
    .stars,
    .stars::before,
    .stars::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(circle, white 1px, transparent 1px),
        radial-gradient(circle, #9bb7ff 1px, transparent 1px),
        radial-gradient(circle, white 1px, transparent 1px);
      background-size: 90px 90px, 140px 140px, 220px 220px;
      background-position: 10px 20px, 50px 80px, 120px 40px;
      opacity: 0.5;
      animation: starsMove 35s linear infinite;
      pointer-events: none;
    }

    .stars::before {
      opacity: 0.25;
      animation-duration: 60s;
    }

    .stars::after {
      opacity: 0.2;
      animation-duration: 90s;
    }

    @keyframes starsMove {
      from {
        transform: translateY(0);
      }
      to {
        transform: translateY(90px);
      }
    }

    /* Nebula */
    .nebula {
      position: absolute;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(
        circle,
        rgba(77, 91, 255, 0.18),
        rgba(130, 40, 255, 0.08),
        transparent 70%
      );
      filter: blur(20px);
      animation: pulse 6s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% {
        transform: scale(1);
        opacity: 0.7;
      }
      50% {
        transform: scale(1.12);
        opacity: 1;
      }
    }

    /* Main content */
    .container {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: 30px;
      max-width: 850px;
    }

    .logo {
      width: 95px;
      height: 95px;
      margin: 0 auto 25px;
      border-radius: 26px;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 42px;
      font-weight: 900;

      background: linear-gradient(135deg, #6d5cff, #9b4dff);
      box-shadow:
        0 0 25px rgba(108, 92, 255, 0.6),
        0 0 70px rgba(132, 67, 255, 0.25);

      animation: float 4s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }

    h1 {
      font-size: clamp(55px, 12vw, 110px);
      font-weight: 900;
      letter-spacing: -5px;

      background: linear-gradient(
        90deg,
        #ffffff,
        #b9b6ff,
        #8d73ff,
        #ffffff
      );

      background-size: 250% auto;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;

      animation: shine 5s linear infinite;

      text-shadow: 0 0 40px rgba(125, 103, 255, 0.2);
    }

    @keyframes shine {
      to {
        background-position: 250% center;
      }
    }

    .tagline {
      margin-top: 8px;
      font-size: clamp(16px, 3vw, 21px);
      color: #aeb4d8;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .coming {
      display: inline-block;
      margin-top: 32px;
      padding: 10px 22px;
      border: 1px solid rgba(145, 130, 255, 0.5);
      border-radius: 999px;

      color: #d8d4ff;
      background: rgba(90, 70, 200, 0.12);
      backdrop-filter: blur(10px);

      font-size: 13px;
      font-weight: bold;
      letter-spacing: 2px;
    }

    .description {
      max-width: 570px;
      margin: 25px auto 0;
      color: #858cad;
      line-height: 1.7;
      font-size: 15px;
    }

    /* YouTube button */
    .youtube {
      display: inline-flex;
      align-items: center;
      gap: 10px;

      margin-top: 35px;
      padding: 14px 24px;

      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.12);

      background: rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(15px);

      color: white;
      text-decoration: none;
      font-weight: 700;

      transition:
        transform 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;
    }

    .youtube:hover {
      transform: translateY(-4px);
      background: rgba(255, 255, 255, 0.13);
      box-shadow: 0 10px 35px rgba(100, 80, 255, 0.25);
    }

    .youtube-icon {
      width: 24px;
      height: 17px;
      border-radius: 5px;
      background: #ff1744;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .youtube-icon::after {
      content: "";
      width: 0;
      height: 0;
      border-top: 4px solid transparent;
      border-bottom: 4px solid transparent;
      border-left: 7px solid white;
      margin-left: 2px;
    }

    /* Bottom text */
    .footer {
      position: fixed;
      bottom: 22px;
      left: 0;
      right: 0;

      text-align: center;
      color: #555b78;
      font-size: 12px;
      letter-spacing: 1px;
      z-index: 3;
    }

    /* Shooting star */
    .shooting-star {
      position: absolute;
      top: 20%;
      left: -150px;
      width: 120px;
      height: 2px;

      background: linear-gradient(
        90deg,
        transparent,
        #fff,
        transparent
      );

      transform: rotate(-25deg);
      opacity: 0;

      animation: shoot 8s linear infinite;
    }

    @keyframes shoot {
      0% {
        left: -150px;
        top: 20%;
        opacity: 0;
      }

      5% {
        opacity: 1;
      }

      15% {
        left: 110%;
        top: 5%;
        opacity: 0;
      }

      100% {
        left: 110%;
        opacity: 0;
      }
    }

    /* Mobile */
    @media (max-width: 600px) {
      .logo {
        width: 75px;
        height: 75px;
        border-radius: 20px;
        font-size: 32px;
      }

      h1 {
        letter-spacing: -3px;
      }

      .description {
        font-size: 14px;
      }

      .coming {
        margin-top: 25px;
      }
    }
  </style>
</head>

<body>

  <div class="stars"></div>
  <div class="nebula"></div>
  <div class="shooting-star"></div>

  <main class="container">

    <div class="logo">
      H
    </div>

    <h1>HYPLIX</h1>

    <div class="tagline">
      Minecraft Launcher
    </div>

    <div class="coming">
      🚀 COMING SOON
    </div>

    <p class="description">
      A new way to launch, manage and experience Minecraft.
      Hyplix is currently under development.
      Something is being built in the void.
    </p>

    <!-- Replace the link below with your YouTube channel -->
    <a
      class="youtube"
      href="YOUR_YOUTUBE_CHANNEL_LINK"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="youtube-icon"></span>
      Visit my YouTube
    </a>

  </main>

  <div class="footer">
    © 2026 HYPLIX • THE LAUNCH IS COMING
  </div>

</body>
</html>